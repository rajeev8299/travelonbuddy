# TravelOnBuddy — Supabase & Environment Configuration
# Copy this file to .env or .env.local for local development.
# In Vercel, add these keys in Settings -> Environment Variables.

# 1. Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anonymous Client Key (Public anon key, safe for frontend client)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 3. Optional: Transactional Email Gateway Endpoint (for server-side email dispatch)
# VITE_EMAIL_API_URL=https://your-domain.com/api/send-confirmation-email
